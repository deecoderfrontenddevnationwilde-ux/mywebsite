# Copy this file to ".env" and fill in real values.
# NEVER commit the real ".env" file to git — it is already listed in .gitignore.

# Flask
SECRET_KEY=change-this-to-a-long-random-string
FLASK_ENV=development
FLASK_DEBUG=1

# Database (SQLite for now — swap for a PostgreSQL URL later, e.g.
# postgresql://user:password@host:5432/dbname — no code changes required)
DATABASE_URL=sqlite:///instance/company.db

# Company info (used in emails)
COMPANY_NAME=DeeCoder Technologies
SITE_URL=http://127.0.0.1:5000

# Gmail SMTP (use a Gmail "App Password", NOT your normal Gmail password)
# Create one at https://myaccount.google.com/apppasswords (requires 2-Step Verification)
GMAIL_ADDRESS=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password
# Inbox that receives website subscription and contact notifications.
NOTIFICATION_EMAIL=deecodertechnologiesworldwide@gmail.com
# Contact notifications use this dedicated inbox; defaults to the public contact address.
CONTACT_NOTIFICATION_EMAIL=deecodertechnologiesworldwide@gmail.com
# Defaults match Gmail STARTTLS. Use SMTP_USE_SSL=1 and SMTP_PORT=465 if required.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_SSL=0
SMTP_TIMEOUT=20

# Upload limits
MAX_UPLOAD_MB=5
MAX_VIDEO_UPLOAD_MB=500
VIDEO_UPLOAD_CHUNK_MB=8
